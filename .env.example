# Copy to .env.local (development) or the server's env file (production).

# Postgres connection for the app's own role. Production points at the
# Supabase database container on the ZimaOS box; never commit the password.
DATABASE_URL=postgres://dentec_app:CHANGE_ME@db:5432/postgres
# Connections in the pool. 1 for the local PGlite dev database.
DATABASE_POOL_SIZE=5
