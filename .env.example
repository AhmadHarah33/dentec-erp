# ---------------------------------------------------------------------------
# Dentec ERP environment. Copy to .env (or .env.local for `npm run dev`).
# Leave the Supabase values empty to run the offline demo on sample data.
# ---------------------------------------------------------------------------

# Where the app reaches Supabase (Kong / API gateway).
#  - Same Docker network as Supabase:   http://kong:8000
#  - Anywhere else:                     https://supabase.your-domain.com
SUPABASE_URL=

# From your Supabase .env: ANON_KEY
SUPABASE_ANON_KEY=

# From your Supabase .env: SERVICE_ROLE_KEY. Server-only — never exposed to
# browsers. Needed to invite users and for the first-run setup.
SUPABASE_SERVICE_ROLE_KEY=

# The NEXT_PUBLIC_ spellings are accepted too, if you already use them:
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Business time zone for timestamps. Compiled into the build: for Docker pass
# it as --build-arg NEXT_PUBLIC_TIME_ZONE=... instead.
NEXT_PUBLIC_TIME_ZONE=Europe/Istanbul

# Only needed outside the Docker image (it sets these itself):
# CHROMIUM_PATH=/usr/bin/chromium        # browser used for PDF export
# APP_INTERNAL_URL=http://127.0.0.1:3000 # how that browser reaches this app
